# ==========================================
# RESTful API URL Rewrite (.htaccess)
# รองรับทั้ง Localhost และ Railway Cloud
# ==========================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # หากมีการเข้าถึงไฟล์หรือโฟลเดอร์ที่มีอยู่จริง ไม่ต้อง rewrite
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # ส่งทุก Request ไปประมวลผลที่ index.php
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>
